# Выбор конфигурации экспериментов
L2SB_EXPERIMENTS_CONFIG=configs/experiments.yaml
L2SB_MODELS_CONFIG_PATH=configs/models.yaml
L2SB_EXPERIMENT=spider_env_demo
L2SB_EXPERIMENT_NAMES=spider_env_demo,bird_env_demo

# Пути к данным и директория результатов
L2SB_DATASET=spider
L2SB_DATASET_PATH=datasets/spider/sample.jsonl
L2SB_DB_PATH=
L2SB_OUTPUT_DIR=results/runs

# Параметры генерации
L2SB_MODEL_KEY=ollama_default
L2SB_K=1
L2SB_LIMIT=
L2SB_MODEL_TIMEOUT=120

# Настройки Ollama
L2SB_OLLAMA_MODEL_NAME=qwen2.5-coder:7b
L2SB_OLLAMA_BASE_URL=http://localhost:11434
L2SB_OLLAMA_TEMPERATURE=0.0

# Настройки OpenAI-совместимого API
OPENAI_API_KEY=
L2SB_API_MODEL_NAME=gpt-4o-mini
L2SB_API_BASE_URL=https://api.openai.com
L2SB_API_TEMPERATURE=0.0
L2SB_API_MAX_TOKENS=256

# Опциональный профиль второго эксперимента (bird_env_demo)
L2SB_DATASET_BIRD=bird
L2SB_DATASET_PATH_BIRD=datasets/bird/sample.jsonl
L2SB_MODEL_KEY_BIRD=api_default
L2SB_K_BIRD=1
L2SB_LIMIT_BIRD=
L2SB_DB_PATH_BIRD=
